{
  "compilerOptions": {
    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "noEmit": true,

    "strict": true,
    "verbatimModuleSyntax": true,

    "types": ["node"],

    // Templates author against the published package name; resolve it to source
    // here so `npm run check:templates` validates them against the real types.
    "baseUrl": ".",
    "paths": {
      "@burn0/silo": ["./src/public.ts"]
    },

    "resolveJsonModule": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },

  "include": ["templates/**/*.ts", "examples/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

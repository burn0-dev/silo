{
  "name": "silo",
  "version": "0.1.0",
  "description": "Local-first framework for simulating environments and evaluating AI agents against them, with tools, tasks, and verifiers defined as TypeScript in your own repo.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "ink": "^7.1.1",
    "react": "^19.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "main": "index.js",
  "keywords": [
    "ai",
    "agents",
    "agent-evaluation",
    "evals",
    "simulation",
    "environment",
    "sandbox",
    "benchmark",
    "reinforcement-learning",
    "tool-use",
    "local-first",
    "cli",
    "typescript"
  ]
}
